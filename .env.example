# Copy to .env (gitignored) and replace the placeholders with real values.
# Never commit real API keys, passwords or tokens to this public repository.

# Local Postgres credentials. These defaults are for local development only.
POSTGRES_DB=careplatform
POSTGRES_USER=careplatform
POSTGRES_PASSWORD=careplatform

# Gemini Developer API (Google AI Studio). Leave the key empty to run deterministically.
LLM_ENABLED=true
LLM_API_KEY=your-gemini-api-key
LLM_MODEL=gemini-3.6-flash
LLM_BASE_URL=https://generativelanguage.googleapis.com
LLM_TIMEOUT_MS=5000

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
